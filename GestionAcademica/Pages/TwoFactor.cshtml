@page
@model GestionAcademica.Pages.TwoFactorModel
@{
    ViewData["Title"] = "Verificación en Dos Pasos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Gestión Académica</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .verification-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            padding: 3rem;
            width: 100%;
            max-width: 500px;
            text-align: center;
        }

        .icon-section {
            margin-bottom: 2rem;
        }

        .security-icon {
            font-size: 4rem;
            color: #667eea;
            margin-bottom: 1rem;
        }

        .code-input {
            font-size: 2rem;
            text-align: center;
            letter-spacing: 0.5rem;
            border: 2px solid #e9ecef;
            border-radius: 15px;
            padding: 1rem;
            margin: 1rem 0;
            font-weight: bold;
        }

            .code-input:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            }

        .btn-verify {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            color: white;
            width: 100%;
            font-weight: 600;
            font-size: 1.1rem;
        }

            .btn-verify:hover {
                background: linear-gradient(45deg, #5a67d8, #6b46c1);
                transform: translateY(-2px);
            }

        .btn-resend {
            background: transparent;
            border: 2px solid #667eea;
            color: #667eea;
            border-radius: 12px;
            padding: 0.75rem 2rem;
            margin-top: 1rem;
            width: 100%;
            font-weight: 600;
        }

            .btn-resend:hover {
                background: #667eea;
                color: white;
            }

        .timer-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 1rem;
            margin: 1rem 0;
        }

        .timer {
            font-size: 1.2rem;
            font-weight: bold;
            color: #dc3545;
        }

        .user-info {
            background: rgba(102, 126, 234, 0.1);
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="verification-container">
        <!-- Icon Section -->
        <div class="icon-section">
            <div class="security-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h2>Verificación en Dos Pasos</h2>
            <p class="text-muted">Se ha enviado un código de seguridad a tu email</p>
        </div>

        <!-- User Info -->
        <div class="user-info">
            <strong><i class="fas fa-user me-2"></i>@Model.UserName</strong><br>
            <small class="text-muted"><i class="fas fa-envelope me-1"></i>@Model.UserEmail</small>
        </div>

        <!-- Alert Messages -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @TempData["InfoMessage"]
            </div>
        }

        <!-- Verification Form -->
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label class="form-label">Código de Verificación (6 dígitos)</label>
                <input asp-for="VerificationCode" class="form-control code-input"
                       maxlength="6" placeholder="000000"
                       pattern="[0-9]{6}" required
                       autocomplete="off">
                <span asp-validation-for="VerificationCode" class="text-danger"></span>
            </div>

            <div class="timer-section">
                <i class="fas fa-clock me-2"></i>
                El código expira en: <span class="timer" id="countdown">5:00</span>
            </div>

            <button type="submit" class="btn btn-verify">
                <i class="fas fa-check me-2"></i>
                Verificar Código
            </button>

            <button type="submit" name="resend" value="true" class="btn btn-resend">
                <i class="fas fa-redo me-2"></i>
                Reenviar Código
            </button>
        </form>

        <!-- Help Section -->
        <div class="mt-4 pt-4 border-top">
            <small class="text-muted">
                <i class="fas fa-question-circle me-1"></i>
                ¿No recibiste el código? Revisa tu carpeta de spam o haz clic en "Reenviar Código"
            </small>
        </div>

        <!-- Logout Option -->
        <div class="mt-3">
            <a href="/Logout" class="btn btn-link text-muted">
                <i class="fas fa-sign-out-alt me-1"></i>
                Cancelar y Cerrar Sesión
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Contador regresivo de 5 minutos
        let timeLeft = 300; // 5 minutos en segundos
        const countdown = document.getElementById('countdown');

        function updateTimer() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            countdown.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;

            if (timeLeft === 0) {
                countdown.textContent = 'Expirado';
                countdown.style.color = '#dc3545';
                // Opcionalmente redirigir al login
                // window.location.href = '/Login';
            } else {
                timeLeft--;
            }
        }

        // Actualizar cada segundo
        setInterval(updateTimer, 1000);

        // Auto-focus en el input del código
        document.querySelector('.code-input').focus();

        // Solo permitir números en el input
        document.querySelector('.code-input').addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
</body>
</html>