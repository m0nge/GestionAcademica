@page
@model GestionAcademica.Pages.Materias.CreateModel

@{
    ViewData["Title"] = "Crear Nueva Materia";
}

<!-- Header Section -->
<div class="create-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="fas fa-plus me-2"></i>
                        Nueva Materia
                    </div>
                    <h1 class="hero-title">
                        <i class="fas fa-book-medical me-3"></i>
                        Crear Nueva Materia
                    </h1>
                    <p class="hero-subtitle">
                        Completa los datos para registrar una nueva materia en el sistema y asignar un docente responsable.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 text-end">
                <a asp-page="./Index" class="btn btn-back">
                    <i class="fas fa-arrow-left me-2"></i>
                    Volver a Materias
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Formulario -->
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-container">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-4">
                        <!-- Información básica -->
                        <div class="col-12">
                            <div class="form-section">
                                <h4 class="section-title">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Información Básica
                                </h4>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label asp-for="Materia.Codigo" class="form-label">
                                                <i class="fas fa-hashtag me-2"></i>Código de la Materia
                                            </label>
                                            <input asp-for="Materia.Codigo" class="form-control"
                                                   placeholder="Ej: MAT101" maxlength="10" style="text-transform: uppercase;">
                                            <span asp-validation-for="Materia.Codigo" class="text-danger"></span>
                                            <div class="form-text">Código único para identificar la materia</div>
                                        </div>
                                    </div>

                                    <div class="col-md-8">
                                        <div class="form-group">
                                            <label asp-for="Materia.Nombre" class="form-label">
                                                <i class="fas fa-book me-2"></i>Nombre de la Materia
                                            </label>
                                            <input asp-for="Materia.Nombre" class="form-control"
                                                   placeholder="Ej: Matemáticas Avanzadas" maxlength="100">
                                            <span asp-validation-for="Materia.Nombre" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Materia.Creditos" class="form-label">
                                                <i class="fas fa-star me-2"></i>Créditos
                                            </label>
                                            <input asp-for="Materia.Creditos" class="form-control"
                                                   type="number" min="1" max="10" value="3">
                                            <span asp-validation-for="Materia.Creditos" class="text-danger"></span>
                                            <div class="form-text">Número de créditos de la materia (1-10)</div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Materia.Periodo" class="form-label">
                                                <i class="fas fa-calendar me-2"></i>Período
                                            </label>
                                            <input asp-for="Materia.Periodo" class="form-control"
                                                   placeholder="Ej: 2024-1" maxlength="20">
                                            <span asp-validation-for="Materia.Periodo" class="text-danger"></span>
                                            <div class="form-text">Período académico</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Asignación académica -->
                        <div class="col-12">
                            <div class="form-section">
                                <h4 class="section-title">
                                    <i class="fas fa-university me-2"></i>
                                    Asignación Académica
                                </h4>

                                <div class="row g-3">
                                    <!-- Facultad -->
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label asp-for="FacultadSeleccionada" class="form-label">
                                                <i class="fas fa-building me-2"></i>Facultad
                                            </label>
                                            <select asp-for="FacultadSeleccionada" asp-items="Model.FacultadesDisponibles"
                                                    class="form-select" id="facultadSelect" required>
                                                <option value="">-- Seleccionar Facultad --</option>
                                            </select>
                                            <div class="form-text">Selecciona primero la facultad para filtrar carreras y docentes</div>
                                        </div>
                                    </div>

                                    <!-- Carrera -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Materia.CarreraID" class="form-label">
                                                <i class="fas fa-graduation-cap me-2"></i>Carrera
                                            </label>
                                            <select asp-for="Materia.CarreraID" asp-items="Model.CarrerasDisponibles"
                                                    class="form-select" id="carreraSelect" required disabled>
                                                <option value="">-- Primero selecciona una facultad --</option>
                                            </select>
                                            <span asp-validation-for="Materia.CarreraID" class="text-danger"></span>
                                            <div class="form-text">Carrera a la que pertenece la materia</div>
                                        </div>
                                    </div>

                                    <!-- Docente -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Materia.DocenteID" class="form-label">
                                                <i class="fas fa-chalkboard-teacher me-2"></i>Docente Responsable
                                            </label>
                                            <select asp-for="Materia.DocenteID" asp-items="Model.DocentesDisponibles"
                                                    class="form-select" id="docenteSelect" required disabled>
                                                <option value="">-- Primero selecciona una facultad --</option>
                                            </select>
                                            <span asp-validation-for="Materia.DocenteID" class="text-danger"></span>
                                            <div class="form-text">Docente que será responsable de esta materia</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Importante:</strong> La carrera y el docente deben pertenecer a la misma facultad.
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="col-12">
                            <div class="form-actions">
                                <button type="submit" class="btn btn-create">
                                    <i class="fas fa-save me-2"></i>
                                    Crear Materia
                                </button>
                                <a asp-page="./Index" class="btn btn-cancel">
                                    <i class="fas fa-times me-2"></i>
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hero Section */
    .create-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-top: -2rem;
        border-radius: 0 0 30px 30px;
    }

    .hero-badge {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        line-height: 1.6;
    }

    .btn-back {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255,255,255,0.3);
        color: white;
        padding: 1rem 2rem;
        border-radius: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            background: rgba(255,255,255,0.3);
            transform: translateY(-2px);
            color: white;
        }

    /* Formulario */
    .form-container {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 15px 50px rgba(0,0,0,0.1);
        border: 1px solid #f0f0f0;
    }

    .form-section {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 2rem;
        border-left: 4px solid #667eea;
    }

    .section-title {
        color: #2c3e50;
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e9ecef;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

        .form-label i {
            color: #667eea;
            width: 20px;
        }

    .form-control, .form-select {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.15);
        }

    .form-text {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    /* Botones de acción */
    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        padding-top: 2rem;
        border-top: 2px solid #e9ecef;
        margin-top: 2rem;
    }

    .btn-create {
        background: linear-gradient(45deg, #667eea, #764ba2);
        border: none;
        color: white;
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
    }

        .btn-create:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
        }

    .btn-cancel {
        background: #6c757d;
        border: none;
        color: white;
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #5a6268;
            transform: translateY(-3px);
            color: white;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Elementos del formulario
        var facultadSelect = document.getElementById('facultadSelect');
        var carreraSelect = document.getElementById('carreraSelect');
        var docenteSelect = document.getElementById('docenteSelect');
        var codigoInput = document.querySelector('input[name="Materia.Codigo"]');

        // Convertir código a mayúsculas automáticamente
        if (codigoInput) {
            codigoInput.addEventListener('input', function() {
                this.value = this.value.toUpperCase();
            });
        }

        // Cuando cambia la facultad
        if (facultadSelect) {
            facultadSelect.addEventListener('change', function() {
                var facultadId = this.value;

                if (facultadId) {
                    // Habilitar los selects
                    carreraSelect.disabled = false;
                    docenteSelect.disabled = false;

                    // Cargar carreras
                    cargarCarreras(facultadId);

                    // Cargar docentes
                    cargarDocentes(facultadId);
                } else {
                    // Deshabilitar y limpiar
                    carreraSelect.disabled = true;
                    docenteSelect.disabled = true;
                    carreraSelect.innerHTML = '<option value="">-- Primero selecciona una facultad --</option>';
                    docenteSelect.innerHTML = '<option value="">-- Primero selecciona una facultad --</option>';
                }
            });
        }

        // Función para cargar carreras
        function cargarCarreras(facultadId) {
            fetch('?handler=CarrerasPorFacultad&facultadId=' + facultadId)
                .then(function(response) {
                    return response.json();
                })
                .then(function(carreras) {
                    carreraSelect.innerHTML = '<option value="">-- Seleccionar Carrera --</option>';

                    for (var i = 0; i < carreras.length; i++) {
                        var carrera = carreras[i];
                        var option = document.createElement('option');
                        option.value = carrera.value;
                        option.textContent = carrera.text;
                        carreraSelect.appendChild(option);
                    }
                })
                .catch(function(error) {
                    console.error('Error cargando carreras:', error);
                    carreraSelect.innerHTML = '<option value="">Error cargando carreras</option>';
                });
        }

        // Función para cargar docentes
        function cargarDocentes(facultadId) {
            fetch('?handler=DocentesPorFacultad&facultadId=' + facultadId)
                .then(function(response) {
                    return response.json();
                })
                .then(function(docentes) {
                    docenteSelect.innerHTML = '<option value="">-- Seleccionar Docente --</option>';

                    for (var i = 0; i < docentes.length; i++) {
                        var docente = docentes[i];
                        var option = document.createElement('option');
                        option.value = docente.value;
                        option.textContent = docente.text;
                        docenteSelect.appendChild(option);
                    }
                })
                .catch(function(error) {
                    console.error('Error cargando docentes:', error);
                    docenteSelect.innerHTML = '<option value="">Error cargando docentes</option>';
                });
        }

        // Validación mejorada del formulario
        var form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                var codigo = document.querySelector('input[name="Materia.Codigo"]').value;
                var nombre = document.querySelector('input[name="Materia.Nombre"]').value;
                var carrera = carreraSelect.value;
                var docente = docenteSelect.value;

                if (!codigo || !nombre || !carrera || !docente) {
                    e.preventDefault();
                    alert('Por favor completa todos los campos obligatorios:\n- Código\n- Nombre\n- Carrera\n- Docente');
                    return false;
                }
            });
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}