    document.getElementById('editForm').addEventListener('input', function() {
        clearTimeout(autoSaveTimeout);
        autoSaveTimeout = setTimeout(() => {
            const changes = getFormChanges();
            if (Object.keys(changes).length > 0) {
                console.log('Auto-guardando cambios...', changes);
                // Aquí se implementaría el auto-guardado
            }
        }, 5000); // Auto-guardar después de 5 segundos de inactividad
    });
    */
       // 🌐 FUNCIÓN PARA CARGAR CARRERAS POR FACULTAD USANDO AJAX
    async function cargarCarrerasPorFacultad() {
        const facultadSelect = document.getElementById('facultadSelect');
        const carreraSelect = document.getElementById('carreraSelect');
        const facultadId = facultadSelect.value;

        // Limpiar carreras
        carreraSelect.innerHTML = '<option value="">Seleccionar Carrera</option>';

        if (!facultadId) {
            carreraSelect.disabled = true;
            carreraSelect.innerHTML = '<option value="">Primero selecciona una facultad</option>';
            return;
        }

        try {
            // Mostrar loading
            carreraSelect.innerHTML = '<option value="">Cargando carreras...</option>';
            carreraSelect.disabled = true;

            // 🚀 HACER PETICIÓN AJAX REAL A TU SERVIDOR
            const response = await fetch(`?handler=CarrerasPorFacultad&facultadId=${facultadId}`);

            if (response.ok) {
                const carreras = await response.json();

                // Limpiar y llenar select con datos reales
                carreraSelect.innerHTML = '<option value="">Seleccionar Carrera</option>';

                if (carreras.length > 0) {
                    carreras.forEach(carrera => {
                        const option = document.createElement('option');
                        option.value = carrera.value;
                        option.textContent = carrera.text;
                        carreraSelect.appendChild(option);
                    });
                    carreraSelect.disabled = false;
                } else {
                    carreraSelect.innerHTML = '<option value="">No hay carreras disponibles</option>';
                    carreraSelect.disabled = true;
                }
            } else {
                throw new Error('Error en la respuesta del servidor');
            }
        } catch (error) {
            console.error('Error cargando carreras:', error);
            carreraSelect.innerHTML = '<option value="">Error cargando carreras - Intenta de nuevo</option>';
            carreraSelect.disabled = true;

            // Mostrar mensaje de error al usuario
            showFormError('Error al cargar las carreras. Por favor, recarga la página e intenta de nuevo.');
        }
    }

    // Inicializar carrera al cargar la página si ya hay una facultad seleccionada
    document.addEventListener('DOMContentLoaded', function() {
        const facultadSelect = document.getElementById('facultadSelect');
        if (facultadSelect && facultadSelect.value) {
            cargarCarrerasPorFacultad();
        }
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
