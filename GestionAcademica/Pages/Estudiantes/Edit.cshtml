@page
@model GestionAcademica.Pages.Estudiantes.EditModel
@{
    ViewData["Title"] = $"Editar - {Model.Estudiante.Nombres} {Model.Estudiante.Apellidos}";
}

<!-- Header Simple -->
<div class="edit-header-calm">
    <div class="container">
        <div class="header-content">
            <div class="breadcrumb-calm">
                <a asp-page="./Index" class="breadcrumb-link">
                    <i class="fas fa-users me-2"></i>Estudiantes
                </a>
                <i class="fas fa-chevron-right mx-2"></i>
                <a asp-page="./Details" asp-route-id="@Model.Estudiante.EstudianteID" class="breadcrumb-link">
                    @Model.Estudiante.Nombres @Model.Estudiante.Apellidos
                </a>
                <i class="fas fa-chevron-right mx-2"></i>
                <span class="breadcrumb-current">Editar</span>
            </div>
            <h1 class="page-title-calm">
                <i class="fas fa-edit me-3"></i>
                Editar Estudiante
            </h1>
            <p class="page-subtitle-calm">
                Modifica la información del estudiante. Los campos marcados con <span class="required-mark">*</span> son obligatorios.
            </p>
        </div>
    </div>
</div>

<!-- Formulario Principal -->
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="edit-form-calm">
                <!-- Header del formulario -->
                <div class="form-header-calm">
                    <div class="student-info-preview">
                        <div class="student-avatar-small">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="student-details-small">
                            <h4>@Model.Estudiante.Nombres @Model.Estudiante.Apellidos</h4>
                            <p>Carnet: @Model.Estudiante.Carnet | ID: #@Model.Estudiante.EstudianteID</p>
                        </div>
                        <div class="student-status-small">
                            @if(Model.Estudiante.Activo)
                            {
                                <span class="status-badge-small active">Activo</span>
                            }
                            else
                            {
                                <span class="status-badge-small inactive">Inactivo</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Formulario -->
                <form method="post" id="editForm" class="form-calm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger calm-alert" role="alert"></div>
                    <input type="hidden" asp-for="Estudiante.EstudianteID" />

                    <!-- Información de Identificación -->
                    <div class="form-section-calm">
                        <div class="section-title-calm">
                            <i class="fas fa-id-card me-2"></i>
                            Información de Identificación
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.Carnet" class="form-label-calm">
                                        <span class="required-mark">*</span>
                                        Carnet Estudiantil
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-id-card input-icon-calm"></i>
                                        <input asp-for="Estudiante.Carnet" class="form-input-calm" 
                                               placeholder="Ej: 2024001" maxlength="20" required />
                                    </div>
                                    <span asp-validation-for="Estudiante.Carnet" class="field-error-calm"></span>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Debe ser único en el sistema
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.Email" class="form-label-calm">
                                        Correo Electrónico
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-envelope input-icon-calm"></i>
                                        <input asp-for="Estudiante.Email" class="form-input-calm" 
                                               type="email" placeholder="estudiante@ejemplo.com" />
                                    </div>
                                    <span asp-validation-for="Estudiante.Email" class="field-error-calm"></span>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Debe ser un email válido
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información Personal -->
                    <div class="form-section-calm">
                        <div class="section-title-calm">
                            <i class="fas fa-user me-2"></i>
                            Información Personal
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.Nombres" class="form-label-calm">
                                        <span class="required-mark">*</span>
                                        Nombres
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-user input-icon-calm"></i>
                                        <input asp-for="Estudiante.Nombres" class="form-input-calm" 
                                               placeholder="Nombres completos" maxlength="100" required />
                                    </div>
                                    <span asp-validation-for="Estudiante.Nombres" class="field-error-calm"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.Apellidos" class="form-label-calm">
                                        <span class="required-mark">*</span>
                                        Apellidos
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-user input-icon-calm"></i>
                                        <input asp-for="Estudiante.Apellidos" class="form-input-calm" 
                                               placeholder="Apellidos completos" maxlength="100" required />
                                    </div>
                                    <span asp-validation-for="Estudiante.Apellidos" class="field-error-calm"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.Telefono" class="form-label-calm">
                                        Teléfono
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-phone input-icon-calm"></i>
                                        <input asp-for="Estudiante.Telefono" class="form-input-calm" 
                                               placeholder="0000-0000" maxlength="9" />
                                    </div>
                                    <span asp-validation-for="Estudiante.Telefono" class="field-error-calm"></span>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Formato: 0000-0000
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.FechaNacimiento" class="form-label-calm">
                                        Fecha de Nacimiento
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-calendar input-icon-calm"></i>
                                        <input asp-for="Estudiante.FechaNacimiento" class="form-input-calm" 
                                               type="date" max="2009-12-31" min="1900-01-01" />
                                    </div>
                                    <span asp-validation-for="Estudiante.FechaNacimiento" class="field-error-calm"></span>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Entre 1900 y 2009
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Información Académica - AGREGAR DESPUÉS DE LA SECCIÓN "Información Personal" -->
                    <div class="form-section-calm">
                        <div class="section-title-calm">
                            <i class="fas fa-university me-2"></i>
                            Información Académica
                        </div>

                        <div class="row g-4">
                            <!-- Facultad -->
                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label for="facultadSelect" class="form-label-calm">
                                        <span class="required-mark">*</span>
                                        Facultad
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-building input-icon-calm"></i>
                                        <select id="facultadSelect" class="form-input-calm"
                                                onchange="cargarCarrerasPorFacultad()" required>
                                            <option value="">Seleccionar Facultad</option>
                                            @if (Model.FacultadSelectList != null)
                                            {
                                                @foreach (var facultad in Model.FacultadSelectList)
                                                {
                                                    @if (facultad.Selected)
                                                    {
                                                        <option value="@facultad.Value" selected>@facultad.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@facultad.Value">@facultad.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Selecciona primero la facultad
                                    </div>
                                </div>
                            </div>

                            <!-- Carrera -->
                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.CarreraID" class="form-label-calm">
                                        <span class="required-mark">*</span>
                                        Carrera
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-graduation-cap input-icon-calm"></i>
                                        <select asp-for="Estudiante.CarreraID" id="carreraSelect"
                                                class="form-input-calm" required>
                                            <option value="">Seleccionar Carrera</option>
                                            @if (Model.CarreraSelectList != null)
                                            {
                                                @foreach (var carrera in Model.CarreraSelectList)
                                                {
                                                    @if (carrera.Selected)
                                                    {
                                                        <option value="@carrera.Value" selected>@carrera.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@carrera.Value">@carrera.Text</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <span asp-validation-for="Estudiante.CarreraID" class="field-error-calm"></span>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Depende de la facultad seleccionada
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del Sistema -->
                    <div class="form-section-calm">
                        <div class="section-title-calm">
                            <i class="fas fa-cog me-2"></i>
                            Información del Sistema
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label asp-for="Estudiante.FechaIngreso" class="form-label-calm">
                                        Fecha de Ingreso
                                    </label>
                                    <div class="input-wrapper-calm">
                                        <i class="fas fa-calendar-plus input-icon-calm"></i>
                                        <input asp-for="Estudiante.FechaIngreso" class="form-input-calm" 
                                               type="datetime-local" />
                                    </div>
                                    <span asp-validation-for="Estudiante.FechaIngreso" class="field-error-calm"></span>
                                    <div class="field-hint-calm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Fecha de registro en el sistema
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group-calm">
                                    <label class="form-label-calm">Estado del Estudiante</label>
                                    <div class="switch-container-calm">
                                        <div class="switch-calm">
                                            <input asp-for="Estudiante.Activo" type="checkbox" 
                                                   class="switch-input-calm" id="activoSwitch">
                                            <label class="switch-label-calm" for="activoSwitch">
                                                <span class="switch-slider-calm">
                                                    <span class="switch-text-calm off">Inactivo</span>
                                                    <span class="switch-text-calm on">Activo</span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="switch-description-calm">
                                            <small>Determina si el estudiante puede acceder al sistema</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="form-actions-calm">
                        <div class="actions-left">
                            <a asp-page="./Details" asp-route-id="@Model.Estudiante.EstudianteID" class="btn-calm secondary">
                                <i class="fas fa-eye me-2"></i>
                                Ver Detalles
                            </a>
                        </div>
                        <div class="actions-right">
                            <a asp-page="./Index" class="btn-calm tertiary">
                                <i class="fas fa-arrow-left me-2"></i>
                                Cancelar
                            </a>
                            <button type="submit" class="btn-calm primary" id="saveBtn">
                                <i class="fas fa-save me-2"></i>
                                <span class="btn-text">Guardar Cambios</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-calm">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-question-circle me-2"></i>
                    Confirmar Cambios
                </h5>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas guardar los cambios realizados?</p>
                <div class="changes-summary" id="changesSummary"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-calm tertiary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>
                    Cancelar
                </button>
                <button type="button" class="btn-calm primary" id="confirmSave">
                    <i class="fas fa-check me-2"></i>
                    Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Variables para diseño calmado */
    :root {
        --primary-calm: #5a67d8;
        --primary-hover: #4c51bf;
        --secondary-calm: #718096;
        --success-calm: #38a169;
        --warning-calm: #d69e2e;
        --danger-calm: #e53e3e;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-400: #9ca3af;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-800: #1f2937;
        --gray-900: #111827;
        --shadow-calm: 0 4px 15px rgba(0, 0, 0, 0.08);
        --shadow-hover-calm: 0 8px 25px rgba(0, 0, 0, 0.12);
        --border-radius-calm: 12px;
        --transition-calm: all 0.3s ease;
    }

    /* Reset y base */
    * {
        box-sizing: border-box;
    }

    body {
        background-color: var(--gray-50);
        color: var(--gray-700);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.6;
    }

    /* Header calmado */
    .edit-header-calm {
        background: white;
        border-bottom: 1px solid var(--gray-200);
        padding: 2rem 0;
        margin-bottom: 2rem;
    }

    .header-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .breadcrumb-calm {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: var(--gray-500);
    }

    .breadcrumb-link {
        color: var(--primary-calm);
        text-decoration: none;
        transition: var(--transition-calm);
    }

    .breadcrumb-link:hover {
        color: var(--primary-hover);
        text-decoration: underline;
    }

    .breadcrumb-current {
        color: var(--gray-600);
        font-weight: 500;
    }

    .page-title-calm {
        font-size: 2rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

    .page-subtitle-calm {
        color: var(--gray-600);
        font-size: 1rem;
        margin: 0;
    }

    .required-mark {
        color: var(--danger-calm);
        font-weight: 700;
    }

    /* Formulario calmado */
    .edit-form-calm {
        background: white;
        border-radius: var(--border-radius-calm);
        box-shadow: var(--shadow-calm);
        overflow: hidden;
        border: 1px solid var(--gray-200);
    }

    .form-header-calm {
        background: var(--gray-50);
        border-bottom: 1px solid var(--gray-200);
        padding: 1.5rem 2rem;
    }

    .student-info-preview {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .student-avatar-small {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        background: var(--primary-calm);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .student-details-small {
        flex: 1;
    }

    .student-details-small h4 {
        margin: 0 0 0.2rem 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--gray-900);
    }

    .student-details-small p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--gray-500);
    }

    .status-badge-small {
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge-small.active {
        background: rgba(56, 161, 105, 0.1);
        color: var(--success-calm);
        border: 1px solid rgba(56, 161, 105, 0.2);
    }

    .status-badge-small.inactive {
        background: rgba(229, 62, 62, 0.1);
        color: var(--danger-calm);
        border: 1px solid rgba(229, 62, 62, 0.2);
    }

    /* Secciones del formulario */
    .form-calm {
        padding: 2rem;
    }

    .form-section-calm {
        margin-bottom: 3rem;
    }

    .form-section-calm:last-of-type {
        margin-bottom: 2rem;
    }

    .section-title-calm {
        display: flex;
        align-items: center;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--gray-100);
    }

    /* Grupos de formulario */
    .form-group-calm {
        margin-bottom: 1.5rem;
    }

    .form-label-calm {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--gray-700);
        margin-bottom: 0.5rem;
    }

    .input-wrapper-calm {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon-calm {
        position: absolute;
        left: 1rem;
        color: var(--gray-400);
        font-size: 0.9rem;
        z-index: 2;
    }

    .form-input-calm {
        width: 100%;
        padding: 0.8rem 1rem 0.8rem 2.5rem;
        border: 2px solid var(--gray-200);
        border-radius: 8px;
        font-size: 0.95rem;
        background: white;
        transition: var(--transition-calm);
        outline: none;
    }

    .form-input-calm:focus {
        border-color: var(--primary-calm);
        box-shadow: 0 0 0 3px rgba(90, 103, 216, 0.1);
    }

    .form-input-calm:invalid {
        border-color: var(--danger-calm);
    }

    .form-input-calm.is-valid {
        border-color: var(--success-calm);
        background-color: rgba(56, 161, 105, 0.02);
    }

    .form-input-calm.is-invalid {
        border-color: var(--danger-calm);
        background-color: rgba(229, 62, 62, 0.02);
    }

    .field-error-calm {
        display: block;
        color: var(--danger-calm);
        font-size: 0.8rem;
        margin-top: 0.3rem;
        font-weight: 500;
    }

    .field-hint-calm {
        display: flex;
        align-items: center;
        margin-top: 0.4rem;
        font-size: 0.8rem;
        color: var(--gray-500);
    }

    /* Switch calmado */
    .switch-container-calm {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .switch-calm {
        position: relative;
        display: inline-block;
    }

    .switch-input-calm {
        display: none;
    }

    .switch-label-calm {
        display: block;
        width: 120px;
        height: 40px;
        background: var(--gray-200);
        border-radius: 20px;
        cursor: pointer;
        transition: var(--transition-calm);
        position: relative;
        overflow: hidden;
    }

    .switch-slider-calm {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 54px;
        height: 34px;
        background: white;
        border-radius: 17px;
        transition: var(--transition-calm);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }

    .switch-text-calm {
        position: absolute;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: var(--transition-calm);
    }

    .switch-text-calm.off {
        right: 8px;
        color: var(--gray-600);
    }

    .switch-text-calm.on {
        left: 8px;
        color: white;
        opacity: 0;
    }

    .switch-input-calm:checked + .switch-label-calm {
        background: var(--primary-calm);
    }

    .switch-input-calm:checked + .switch-label-calm .switch-slider-calm {
        transform: translateX(60px);
    }

    .switch-input-calm:checked + .switch-label-calm .switch-text-calm.off {
        opacity: 0;
    }

    .switch-input-calm:checked + .switch-label-calm .switch-text-calm.on {
        opacity: 1;
    }

    .switch-description-calm {
        color: var(--gray-500);
    }

    /* Botones calmados */
    .form-actions-calm {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 2rem;
        border-top: 1px solid var(--gray-200);
        gap: 1rem;
    }

    .actions-left,
    .actions-right {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .btn-calm {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        border: 2px solid transparent;
        transition: var(--transition-calm);
        cursor: pointer;
        outline: none;
    }

    .btn-calm.primary {
        background: var(--primary-calm);
        color: white;
        border-color: var(--primary-calm);
    }

    .btn-calm.primary:hover {
        background: var(--primary-hover);
        border-color: var(--primary-hover);
        transform: translateY(-1px);
        box-shadow: var(--shadow-hover-calm);
        color: white;
    }

    .btn-calm.secondary {
        background: var(--gray-100);
        color: var(--gray-700);
        border-color: var(--gray-200);
    }

    .btn-calm.secondary:hover {
        background: var(--gray-200);
        border-color: var(--gray-300);
        transform: translateY(-1px);
        color: var(--gray-700);
    }

    .btn-calm.tertiary {
        background: white;
        color: var(--gray-600);
        border-color: var(--gray-300);
    }

    .btn-calm.tertiary:hover {
        background: var(--gray-50);
        border-color: var(--gray-400);
        color: var(--gray-700);
    }

    /* Alert calmado */
    .calm-alert {
        border: none;
        border-radius: 8px;
        background: rgba(229, 62, 62, 0.1);
        border-left: 4px solid var(--danger-calm);
        color: var(--danger-calm);
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    /* Modal calmado */
    .modal-calm .modal-content {
        border: none;
        border-radius: var(--border-radius-calm);
        box-shadow: var(--shadow-hover-calm);
    }

    .modal-calm .modal-header {
        background: var(--gray-50);
        border-bottom: 1px solid var(--gray-200);
        border-radius: var(--border-radius-calm) var(--border-radius-calm) 0 0;
    }

    .modal-calm .modal-title {
        color: var(--gray-800);
        font-weight: 600;
    }

    .modal-calm .modal-footer {
        background: var(--gray-50);
        border-top: 1px solid var(--gray-200);
        border-radius: 0 0 var(--border-radius-calm) var(--border-radius-calm);
    }

    .changes-summary {
        background: var(--gray-50);
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1rem;
        font-size: 0.9rem;
        color: var(--gray-600);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-title-calm {
            font-size: 1.5rem;
        }
        
        .student-info-preview {
            flex-direction: column;
            text-align: center;
            gap: 0.8rem;
        }
        
        .form-calm {
            padding: 1.5rem;
        }
        
        .form-actions-calm {
            flex-direction: column;
            gap: 1rem;
        }
        
        .actions-left,
        .actions-right {
            width: 100%;
            justify-content: center;
        }
        
        .btn-calm {
            flex: 1;
            justify-content: center;
        }
    }

    /* Estados de loading */
    .btn-calm.loading {
        position: relative;
        color: transparent;
    }

    .btn-calm.loading::after {
        content: '';
        position: absolute;
        width: 16px;
        height: 16px;
        top: 50%;
        left: 50%;
        margin-left: -8px;
        margin-top: -8px;
        border: 2px solid transparent;
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Focus visible para accesibilidad */
    .btn-calm:focus-visible,
    .form-input-calm:focus-visible,
    .switch-label-calm:focus-visible {
        outline: 2px solid var(--primary-calm);
        outline-offset: 2px;
    }

    /* Animaciones sutiles */
    .form-section-calm {
        animation: fadeInUp 0.4s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        initializeForm();
        setupValidation();
        setupInteractions();
    });

    let originalData = {};

    function initializeForm() {
        // Guardar datos originales para comparar cambios
        const form = document.getElementById('editForm');
        const formData = new FormData(form);
        originalData = Object.fromEntries(formData);

        // Formatear teléfono automáticamente
        const telefonoInput = document.querySelector('[name="Estudiante.Telefono"]');
        if (telefonoInput) {
            telefonoInput.addEventListener('input', formatearTelefono);
        }

        // Validar solo letras en nombres y apellidos
        const nombresInput = document.querySelector('[name="Estudiante.Nombres"]');
        const apellidosInput = document.querySelector('[name="Estudiante.Apellidos"]');
        
        if (nombresInput) nombresInput.addEventListener('input', validarSoloLetras);
        if (apellidosInput) apellidosInput.addEventListener('input', validarSoloLetras);
    }

    function setupValidation() {
        const inputs = document.querySelectorAll('.form-input-calm');
        
        inputs.forEach(input => {
            input.addEventListener('blur', function() {
                validateField(this);
            });
            
            input.addEventListener('input', function() {
                if (this.classList.contains('is-invalid')) {
                    validateField(this);
                }
            });
        });
    }

    function setupInteractions() {
        // Efecto hover sutil en inputs
        const inputs = document.querySelectorAll('.form-input-calm');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.style.transform = 'translateY(-1px)';
            });
            
            input.addEventListener('blur', function() {
                this.parentElement.style.transform = 'translateY(0)';
            });
        });

        // Manejo del formulario
        const form = document.getElementById('editForm');
        form.addEventListener('submit', handleSubmit);
    }

    function formatearTelefono(event) {
        let value = event.target.value.replace(/\D/g, '');
        if (value.length >= 4) {
            value = value.substring(0, 4) + '-' + value.substring(4, 8);
        }
        event.target.value = value;
    }

    function validarSoloLetras(event) {
        const regex = /[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g;
        if (regex.test(event.target.value)) {
            event.target.value = event.target.value.replace(regex, '');
            showFieldError(event.target, 'Solo se permiten letras y espacios');
            setTimeout(() => clearFieldError(event.target), 3000);
        }
    }

    function validateField(field) {
        const value = field.value.trim();
        const isRequired = field.hasAttribute('required');
        let isValid = true;
        let errorMessage = '';

        // Validación de campos requeridos
        if (isRequired && !value) {
            isValid = false;
            errorMessage = 'Este campo es obligatorio';
        }

        // Validaciones específicas
        if (value && field.type === 'email') {
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(value)) {
                isValid = false;
                errorMessage = 'Ingrese un email válido';
            }
        }

        if (value && field.name.includes('Telefono')) {
            const phoneRegex = /^\d{4}-\d{4}$/;
            if (!phoneRegex.test(value)) {
                isValid = false;
                errorMessage = 'Formato de teléfono inválido (0000-0000)';
            }
        }

        if (value && field.name.includes('Carnet')) {
            if (value.length < 6) {
                isValid = false;
                errorMessage = 'El carnet debe tener al menos 6 caracteres';
            }
        }

        // Aplicar estilos y mostrar errores
        if (isValid) {
            field.classList.remove('is-invalid');
            field.classList.add('is-valid');
            clearFieldError(field);
        } else {
            field.classList.remove('is-valid');
            field.classList.add('is-invalid');
            showFieldError(field, errorMessage);
        }

        return isValid;
    }

    function showFieldError(field, message) {
        const errorElement = field.parentElement.parentElement.querySelector('.field-error-calm');
        if (errorElement) {
            errorElement.textContent = message;
            errorElement.style.display = 'block';
        }
    }

    function clearFieldError(field) {
        const errorElement = field.parentElement.parentElement.querySelector('.field-error-calm');
        if (errorElement) {
            errorElement.style.display = 'none';
        }
    }

    function handleSubmit(event) {
        event.preventDefault();
        
        // Validar todos los campos
        const inputs = document.querySelectorAll('.form-input-calm');
        let isFormValid = true;
        
        inputs.forEach(input => {
            if (!validateField(input)) {
                isFormValid = false;
            }
        });

        if (!isFormValid) {
            showFormError('Por favor, corrija los errores antes de continuar');
            return;
        }

        // Verificar si hay cambios
        const changes = getFormChanges();
        if (Object.keys(changes).length === 0) {
            showFormInfo('No se detectaron cambios para guardar');
            return;
        }

        // Mostrar modal de confirmación
        showConfirmationModal(changes);
    }

    function getFormChanges() {
        const form = document.getElementById('editForm');
        const currentData = new FormData(form);
        const changes = {};

        for (let [key, value] of currentData.entries()) {
            if (key !== '__RequestVerificationToken' && originalData[key] !== value) {
                changes[key] = {
                    old: originalData[key] || '',
                    new: value
                };
            }
        }

        return changes;
    }

    function showConfirmationModal(changes) {
        const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
        const summaryElement = document.getElementById('changesSummary');
        
        let summaryHtml = '<strong>Cambios detectados:</strong><ul>';
        for (let [field, change] of Object.entries(changes)) {
            const fieldName = getFieldDisplayName(field);
            summaryHtml += `<li><strong>${fieldName}:</strong> "${change.old}" → "${change.new}"</li>`;
        }
        summaryHtml += '</ul>';
        
        summaryElement.innerHTML = summaryHtml;
        modal.show();

        // Configurar botón de confirmación
        document.getElementById('confirmSave').onclick = function() {
            modal.hide();
            submitForm();
        };
    }

    function getFieldDisplayName(fieldName) {
        const fieldNames = {
            'Estudiante.Carnet': 'Carnet',
            'Estudiante.Nombres': 'Nombres',
            'Estudiante.Apellidos': 'Apellidos',
            'Estudiante.Email': 'Email',
            'Estudiante.Telefono': 'Teléfono',
            'Estudiante.FechaNacimiento': 'Fecha de Nacimiento',
            'Estudiante.FechaIngreso': 'Fecha de Ingreso',
            'Estudiante.Activo': 'Estado'
        };
        
        return fieldNames[fieldName] || fieldName;
    }

    function submitForm() {
        const saveBtn = document.getElementById('saveBtn');
        const originalText = saveBtn.querySelector('.btn-text').textContent;

        // Mostrar estado de carga
        saveBtn.classList.add('loading');
        saveBtn.disabled = true;
        saveBtn.querySelector('.btn-text').textContent = 'Guardando...';

        // Enviar formulario directamente
        document.getElementById('editForm').submit();
    }

    function showFormError(message) {
        showFormMessage(message, 'error');
    }

    function showFormInfo(message) {
        showFormMessage(message, 'info');
    }

    function showFormMessage(message, type) {
        // Remover mensaje anterior si existe
        const existingMessage = document.querySelector('.form-message-temp');
        if (existingMessage) {
            existingMessage.remove();
        }

        // Crear nuevo mensaje
        const messageDiv = document.createElement('div');
        messageDiv.className = `alert form-message-temp`;
        messageDiv.style.marginBottom = '1rem';
        
        if (type === 'error') {
            messageDiv.className += ' alert-danger';
            messageDiv.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i>${message}`;
        } else {
            messageDiv.className += ' alert-info';
            messageDiv.innerHTML = `<i class="fas fa-info-circle me-2"></i>${message}`;
        }

        // Insertar mensaje al inicio del formulario
        const form = document.getElementById('editForm');
        form.insertBefore(messageDiv, form.firstChild);

        // Scroll suave al mensaje
        messageDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // Remover mensaje después de 5 segundos
        setTimeout(() => {
            messageDiv.remove();
        }, 5000);
    }


    );

    // Limpiar warning al enviar formulario
    document.getElementById('editForm').addEventListener('submit', function() {
        window.removeEventListener('beforeunload', arguments.callee);
    });

    // Auto-guardar (opcional - comentado por defecto)
