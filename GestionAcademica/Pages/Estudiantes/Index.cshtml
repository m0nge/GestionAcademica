@page
@model GestionAcademica.Pages.Estudiantes.IndexModel

@{
    ViewData["Title"] = "Gestión de Estudiantes";
}

<!-- Hero Header -->
<div class="index-hero-enhanced">
    <div class="hero-bg-pattern"></div>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-content-enhanced">
                    <div class="hero-badge">
                        <i class="fas fa-users me-2"></i>
                        Panel de Control
                    </div>
                    <h1 class="hero-title-enhanced">
                        <i class="fas fa-graduation-cap me-3"></i>
                        Gestión de Estudiantes
                    </h1>
                    <p class="hero-subtitle-enhanced">
                        Administra y visualiza toda la información de los estudiantes registrados en el sistema.
                        <span class="total-count">Total: <strong id="studentCount">@Model.Estudiante.Count()</strong> estudiantes</span>
                    </p>
                    <div class="hero-stats">
                        <div class="stat-item">
                            <i class="fas fa-user-check"></i>
                            <div class="stat-content">
                                <span class="stat-number">@Model.Estudiante.Count(e => e.Activo)</span>
                                <span class="stat-label">Activos</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i class="fas fa-user-times"></i>
                            <div class="stat-content">
                                <span class="stat-number">@Model.Estudiante.Count(e => !e.Activo)</span>
                                <span class="stat-label">Inactivos</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="hero-illustration-enhanced">
                    <div class="floating-elements">
                        <div class="floating-card main-card">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="floating-card small-card card-1">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="floating-card small-card card-2">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="floating-card small-card card-3">
                            <i class="fas fa-award"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Control Panel -->
<div class="container mt-4">
    <div class="control-panel-enhanced">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="search-container-enhanced">
                    <div class="search-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input-enhanced"
                               placeholder="Buscar por carnet, nombre, email, carrera, facultad...">
                        <div class="search-border"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-end">
                <div class="action-buttons-enhanced">
                    <button class="btn btn-filter-enhanced" id="filterBtn">
                        <i class="fas fa-filter me-2"></i>
                        Filtros
                    </button>
                    <a asp-page="./Create" class="btn btn-create-enhanced">
                        <i class="fas fa-plus me-2"></i>
                        Nuevo Estudiante
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros Panel -->
    <div class="filters-panel-enhanced" id="filtersPanel" style="display: none;">
        <div class="filters-content">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="filter-group">
                        <label class="filter-label">Carrera</label>
                        <select class="filter-select" id="careerFilter">
                            <option value="">Todas las carreras</option>
                            @if (Model.Estudiante.Any())
                            {
                                @foreach (var carrera in Model.Estudiante.Where(e => e.Carrera != null).Select(e => e.Carrera).Distinct().OrderBy(c => c.Nombre))
                                {
                                    <option value="@carrera.Nombre">@carrera.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="filter-group">
                        <label class="filter-label">Facultad</label>
                        <select class="filter-select" id="facultyFilter">
                            <option value="">Todas las facultades</option>
                            @if (Model.Estudiante.Any())
                            {
                                @foreach (var facultad in Model.Estudiante.Where(e => e.Carrera?.Facultad != null).Select(e => e.Carrera.Facultad).Distinct().OrderBy(f => f.Nombre))
                                {
                                    <option value="@facultad.Nombre">@facultad.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="filter-group">
                        <label class="filter-label">Estado</label>
                        <select class="filter-select" id="statusFilter">
                            <option value="">Todos</option>
                            <option value="true">Activos</option>
                            <option value="false">Inactivos</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="filter-group">
                        <label class="filter-label">Ordenar por</label>
                        <select class="filter-select" id="sortFilter">
                            <option value="carnet">Carnet</option>
                            <option value="nombres">Nombres</option>
                            <option value="carrera">Carrera</option>
                            <option value="fecha">Fecha de Ingreso</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lista de Estudiantes -->
<div class="container mt-4">
    <div class="students-container-enhanced">
        <div class="students-header">
            <h3>
                <i class="fas fa-list me-2"></i>
                Lista de Estudiantes
            </h3>
            <div class="view-toggle">
                <button class="view-btn active" data-view="cards">
                    <i class="fas fa-th-large"></i>
                </button>
                <button class="view-btn" data-view="table">
                    <i class="fas fa-table"></i>
                </button>
            </div>
        </div>

        <!-- Vista de Cards -->
        <div class="students-grid-enhanced" id="cardsView">
            @foreach (var estudiante in Model.Estudiante)
            {
                <div class="student-card-enhanced"
                     data-carnet="@estudiante.Carnet"
                     data-nombres="@estudiante.Nombres"
                     data-apellidos="@estudiante.Apellidos"
                     data-email="@estudiante.Email"
                     data-carrera="@(estudiante.Carrera?.Nombre ?? "")"
                     data-facultad="@(estudiante.Carrera?.Facultad?.Nombre ?? "")"
                     data-activo="@estudiante.Activo.ToString().ToLower()"
                     data-year="@estudiante.FechaNacimiento?.Year">
                    <div class="card-header-enhanced">
                        <div class="student-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="student-status">
                            @if (estudiante.Activo)
                            {
                                <span class="status-badge active">
                                    <i class="fas fa-check-circle"></i>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="fas fa-times-circle"></i>
                                    Inactivo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body-enhanced">
                        <h4 class="student-name">@estudiante.Nombres @estudiante.Apellidos</h4>
                        <div class="student-details">
                            <div class="detail-item">
                                <i class="fas fa-id-card"></i>
                                <span>@estudiante.Carnet</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-graduation-cap"></i>
                                <span class="carrera-text">@(estudiante.Carrera?.Nombre ?? "Sin carrera")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-building"></i>
                                <span class="facultad-text">@(estudiante.Carrera?.Facultad?.Nombre ?? "Sin facultad")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-envelope"></i>
                                <span>@estudiante.Email</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-phone"></i>
                                <span>@estudiante.Telefono</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-calendar"></i>
                                <span>@estudiante.FechaNacimiento?.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-clock"></i>
                                <span>Ingreso: @estudiante.FechaIngreso.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-actions-enhanced">
                        <a asp-page="./Details" asp-route-id="@estudiante.EstudianteID" class="action-btn details-btn">
                            <i class="fas fa-eye"></i>
                            <span>Ver</span>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@estudiante.EstudianteID" class="action-btn edit-btn">
                            <i class="fas fa-edit"></i>
                            <span>Editar</span>
                        </a>
                        <button class="action-btn delete-btn" onclick="confirmDelete(@estudiante.EstudianteID, '@estudiante.Nombres @estudiante.Apellidos')">
                            <i class="fas fa-trash"></i>
                            <span>Eliminar</span>
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Vista de Tabla -->
        <div class="table-container-enhanced" id="tableView" style="display: none;">
            <div class="table-wrapper">
                <table class="table-enhanced">
                    <thead>
                        <tr>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-id-card me-2"></i>
                                    Carnet
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-user me-2"></i>
                                    Nombres
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-user me-2"></i>
                                    Apellidos
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-graduation-cap me-2"></i>
                                    Carrera
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-building me-2"></i>
                                    Facultad
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-envelope me-2"></i>
                                    Email
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-phone me-2"></i>
                                    Teléfono
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-calendar me-2"></i>
                                    F. Nacimiento
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-clock me-2"></i>
                                    F. Ingreso
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-toggle-on me-2"></i>
                                    Estado
                                </div>
                            </th>
                            <th>
                                <div class="th-content">
                                    <i class="fas fa-cogs me-2"></i>
                                    Acciones
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="studentsTableBody">
                        @foreach (var estudiante in Model.Estudiante)
                        {
                            <tr class="table-row-enhanced"
                                data-carnet="@estudiante.Carnet"
                                data-nombres="@estudiante.Nombres"
                                data-apellidos="@estudiante.Apellidos"
                                data-email="@estudiante.Email"
                                data-carrera="@(estudiante.Carrera?.Nombre ?? "")"
                                data-facultad="@(estudiante.Carrera?.Facultad?.Nombre ?? "")"
                                data-activo="@estudiante.Activo.ToString().ToLower()"
                                data-year="@estudiante.FechaNacimiento?.Year">
                                <td>
                                    <div class="cell-content">
                                        <span class="carnet-badge">@estudiante.Carnet</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        @estudiante.Nombres
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        @estudiante.Apellidos
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <span class="carrera-badge">@(estudiante.Carrera?.Nombre ?? "Sin carrera")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="facultad-info">
                                            <i class="fas fa-building me-1"></i>
                                            <span>@(estudiante.Carrera?.Facultad?.Nombre ?? "Sin facultad")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <a href="mailto:@estudiante.Email" class="email-link">
                                            @estudiante.Email
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        @estudiante.Telefono
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        @estudiante.FechaNacimiento?.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        @estudiante.FechaIngreso.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        @if (estudiante.Activo)
                                        {
                                            <span class="status-badge active">
                                                <i class="fas fa-check-circle"></i>
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive">
                                                <i class="fas fa-times-circle"></i>
                                                Inactivo
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="table-actions">
                                            <a asp-page="./Details" asp-route-id="@estudiante.EstudianteID" class="table-action-btn details" title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-page="./Edit" asp-route-id="@estudiante.EstudianteID" class="table-action-btn edit" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="table-action-btn delete" onclick="confirmDelete(@estudiante.EstudianteID, '@estudiante.Nombres @estudiante.Apellidos')" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Empty State -->
        <div class="empty-state-enhanced" id="emptyState" style="display: none;">
            <div class="empty-illustration">
                <i class="fas fa-search"></i>
            </div>
            <h3>No se encontraron estudiantes</h3>
            <p>Intenta ajustar los filtros de búsqueda o agregar un nuevo estudiante.</p>
            <a asp-page="./Create" class="btn btn-create-enhanced">
                <i class="fas fa-plus me-2"></i>
                Agregar Estudiante
            </a>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal-enhanced">
            <div class="modal-body text-center">
                <div class="delete-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h3>¿Confirmar Eliminación?</h3>
                <p>¿Estás seguro de que deseas eliminar al estudiante <strong id="studentToDelete"></strong>?</p>
                <p class="warning-text">Esta acción no se puede deshacer.</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>
                        Cancelar
                    </button>
                    <form id="deleteForm" method="post" style="display: inline;">
                        <input type="hidden" name="id" id="deleteStudentId">
                        <button type="submit" class="btn btn-danger" formaction="/Estudiantes/Delete">
                            <i class="fas fa-trash me-2"></i>
                            Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Variables CSS */
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --secondary-gradient: linear-gradient(45deg, #f093fb 0%, #f5576c 100%);
        --success-gradient: linear-gradient(45deg, #4facfe 0%, #00f2fe 100%);
        --warning-gradient: linear-gradient(45deg, #ffd89b 0%, #19547b 100%);
        --danger-gradient: linear-gradient(45deg, #ff6b6b 0%, #ffa726 100%);
        --carrera-gradient: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        --shadow-soft: 0 10px 40px rgba(0,0,0,0.1);
        --shadow-hover: 0 20px 60px rgba(0,0,0,0.15);
        --border-radius: 20px;
        --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Hero Section */
    .index-hero-enhanced {
        background: var(--primary-gradient);
        color: white;
        padding: 2rem 0 4rem 0;
        border-radius: 0 0 40px 40px;
        position: relative;
        overflow: hidden;
    }

    .hero-bg-pattern {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255,255,255,0.1) 0%, transparent 50%), radial-gradient(circle at 40% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
        animation: patternMove 20s linear infinite;
    }

    @@keyframes patternMove {
        0%

    {
        transform: translateX(0) translateY(0);
    }

    100% {
        transform: translateX(-100px) translateY(-100px);
    }

    }

    .hero-content-enhanced {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        animation: fadeInUp 0.6s ease-out;
    }

    .hero-title-enhanced {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        animation: fadeInUp 0.6s ease-out 0.2s both;
        text-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .hero-subtitle-enhanced {
        font-size: 1.2rem;
        margin-bottom: 2rem;
        opacity: 0.95;
        line-height: 1.7;
        animation: fadeInUp 0.6s ease-out 0.4s both;
    }

    .total-count {
        display: block;
        margin-top: 0.5rem;
        font-size: 1rem;
    }

    .hero-stats {
        display: flex;
        gap: 2rem;
        animation: fadeInUp 0.6s ease-out 0.6s both;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem 2rem;
        background: rgba(255,255,255,0.15);
        border-radius: 20px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
        min-width: 120px;
    }

        .stat-item i {
            font-size: 1.5rem;
            color: #4facfe;
        }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.9rem;
        opacity: 0.8;
    }

    /* Ilustración Hero */
    .hero-illustration-enhanced {
        position: relative;
        z-index: 2;
    }

    .floating-elements {
        position: relative;
        width: 200px;
        height: 200px;
        margin: 0 auto;
    }

    .floating-card {
        position: absolute;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(15px);
        border: 2px solid rgba(255,255,255,0.2);
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .main-card {
        width: 120px;
        height: 120px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 3rem;
        animation: floatMain 4s ease-in-out infinite;
    }

    .small-card {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
    }

    .card-1 {
        top: 10%;
        right: 10%;
        animation: floatSmall 3s ease-in-out infinite;
    }

    .card-2 {
        bottom: 20%;
        left: 5%;
        animation: floatSmall 3s ease-in-out infinite 1s;
    }

    .card-3 {
        top: 30%;
        left: -10%;
        animation: floatSmall 3s ease-in-out infinite 2s;
    }

    @@keyframes floatMain {
        0%, 100%

    {
        transform: translate(-50%, -50%) translateY(0px) rotate(0deg);
    }

    50% {
        transform: translate(-50%, -50%) translateY(-20px) rotate(5deg);
    }

    }

    @@keyframes floatSmall {
        0%, 100%

    {
        transform: translateY(0px) rotate(0deg);
    }

    50% {
        transform: translateY(-15px) rotate(10deg);
    }

    }

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(40px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Panel de Control */
    .control-panel-enhanced {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-soft);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .search-container-enhanced {
        position: relative;
    }

    .search-wrapper {
        position: relative;
    }

    .search-input-enhanced {
        width: 100%;
        padding: 1rem 1rem 1rem 3rem;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        font-size: 1rem;
        background: white;
        transition: var(--transition);
        outline: none;
    }

        .search-input-enhanced:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.3rem rgba(102, 126, 234, 0.15);
            transform: translateY(-2px);
        }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-size: 1.1rem;
        z-index: 3;
    }

    .search-border {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
