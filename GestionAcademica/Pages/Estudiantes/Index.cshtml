<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        initializeAnimations();
        setupSearch();
        setupFilters();
        setupViewToggle();
        updateStudentCount();
    });

    function initializeAnimations() {
        const cards = document.querySelectorAll('.student-card-enhanced');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            setTimeout(() => {
                card.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100 + 200);
        });
    }

    function setupSearch() {
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('input', function() {
            filterStudents();
        });
    }

    function setupFilters() {
        const filterBtn = document.getElementById('filterBtn');
        const filtersPanel = document.getElementById('filtersPanel');
        const careerFilter = document.getElementById('careerFilter');
        const facultyFilter = document.getElementById('facultyFilter');
        const statusFilter = document.getElementById('statusFilter');
        const sortFilter = document.getElementById('sortFilter');

        filterBtn.addEventListener('click', function() {
            if (filtersPanel.style.display === 'none') {
                filtersPanel.style.display = 'block';
                this.style.background = 'var(--primary-gradient)';
                this.style.color = 'white';
                this.style.borderColor = '#667eea';
            } else {
                filtersPanel.style.display = 'none';
                this.style.background = 'white';
                this.style.color = '#6c757d';
                this.style.borderColor = '#e9ecef';
            }
        });

        [careerFilter, facultyFilter, statusFilter, sortFilter].forEach(filter => {
            filter.addEventListener('change', filterStudents);
        });
    }

    function setupViewToggle() {
        const viewBtns = document.querySelectorAll('.view-btn');
        const cardsView = document.getElementById('cardsView');
        const tableView = document.getElementById('tableView');

        viewBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const view = this.dataset.view;

                viewBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                if (view === 'cards') {
                    cardsView.style.display = 'grid';
                    tableView.style.display = 'none';
                } else {
                    cardsView.style.display = 'none';
                    tableView.style.display = 'block';
                }
            });
        });
    }

    function filterStudents() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
        const careerFilter = document.getElementById('careerFilter').value;
        const facultyFilter = document.getElementById('facultyFilter').value;
        const statusFilter = document.getElementById('statusFilter').value;
        const sortFilter = document.getElementById('sortFilter').value;

        const cards = document.querySelectorAll('.student-card-enhanced');
        const rows = document.querySelectorAll('.table-row-enhanced');

        let visibleCount = 0;
        let allItems = [...cards, ...rows];

        allItems.forEach(item => {
            const carnet = item.dataset.carnet?.toLowerCase() || '';
            const nombres = item.dataset.nombres?.toLowerCase() || '';
            const apellidos = item.dataset.apellidos?.toLowerCase() || '';
            const email = item.dataset.email?.toLowerCase() || '';
            const carrera = item.dataset.carrera || '';
            const facultad = item.dataset.facultad || '';
            const activo = item.dataset.activo;
            const year = item.dataset.year;

            let isVisible = true;

            if (searchTerm) {
                const searchMatch = carnet.includes(searchTerm) ||
                                   nombres.includes(searchTerm) ||
                                   apellidos.includes(searchTerm) ||
                                   email.includes(searchTerm) ||
                                   carrera.toLowerCase().includes(searchTerm) ||
                                   facultad.toLowerCase().includes(searchTerm);
                if (!searchMatch) isVisible = false;
            }

            if (careerFilter && carrera !== careerFilter) {
                isVisible = false;
            }

            if (facultyFilter && facultad !== facultyFilter) {
                isVisible = false;
            }

            if (statusFilter && activo !== statusFilter) {
                isVisible = false;
            }

            if (isVisible) {
                item.style.display = '';
                item.classList.remove('hidden');
                if (item.classList.contains('student-card-enhanced')) {
                    visibleCount++;
                }
            } else {
                item.style.display = 'none';
                item.classList.add('hidden');
            }
        });

        const emptyState = document.getElementById('emptyState');
        const cardsView = document.getElementById('cardsView');
        const tableView = document.getElementById('tableView');

        if (visibleCount === 0) {
            emptyState.style.display = 'block';
            cardsView.style.display = 'none';
            tableView.style.display = 'none';
        } else {
            emptyState.style.display = 'none';
            const activeView = document.querySelector('.view-btn.active').dataset.view;
            if (activeView === 'cards') {
                cardsView.style.display = 'grid';
                tableView.style.display = 'none';
            } else {
                cardsView.style.display = 'none';
                tableView.style.display = 'block';
            }
        }

        updateStudentCount();

        if (sortFilter) {
            sortStudents(sortFilter);
        }
    }

    function sortStudents(criteria) {
        const cardsContainer = document.getElementById('cardsView');
        const tableBody = document.getElementById('studentsTableBody');

        const cards = Array.from(cardsContainer.children).filter(card => !card.classList.contains('hidden'));
        const rows = Array.from(tableBody.children).filter(row => !row.classList.contains('hidden'));

        const sortFunction = (a, b) => {
            let aValue, bValue;

            switch(criteria) {
                case 'carnet':
                    aValue = a.dataset.carnet;
                    bValue = b.dataset.carnet;
                    break;
                case 'nombres':
                    aValue = a.dataset.nombres;
                    bValue = b.dataset.nombres;
                    break;
                case 'carrera':
                    aValue = a.dataset.carrera;
                    bValue = b.dataset.carrera;
                    break;
                case 'fecha':
                    aValue = a.dataset.carnet;
                    bValue = b.dataset.carnet;
                    break;
            }

            return aValue.localeCompare(bValue);
        };

        cards.sort(sortFunction);
        rows.sort(sortFunction);

        cards.forEach(card => cardsContainer.appendChild(card));
        rows.forEach(row => tableBody.appendChild(row));
    }

    function updateStudentCount() {
        const visibleCards = document.querySelectorAll('.student-card-enhanced:not(.hidden)').length;
        const countElement = document.getElementById('studentCount');
        if (countElement) {
            countElement.textContent = visibleCards;
        }
    }

    function confirmDelete(studentId, studentName) {
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        document.getElementById('studentToDelete').textContent = studentName;
        document.getElementById('deleteStudentId').value = studentId;
        modal.show();
    }

    document.addEventListener('mouseover', function(e) {
        if (e.target.closest('.student-card-enhanced')) {
            const card = e.target.closest('.student-card-enhanced');
            card.style.transform = 'translateY(-8px) scale(1.02)';
        }
    });

    document.addEventListener('mouseout', function(e) {
        if (e.target.closest('.student-card-enhanced')) {
            const card = e.target.closest('.student-card-enhanced');
            card.style.transform = 'translateY(0) scale(1)';
        }
    });

    document.addEventListener('click', function(e) {
        if (e.target.closest('.action-btn') || e.target.closest('.table-action-btn')) {
            const btn = e.target.closest('.action-btn') || e.target.closest('.table-action-btn');
            btn.style.transform = 'scale(0.95)';
            setTimeout(() => {
                btn.style.transform = '';
            }, 150);
        }
    });
</script>