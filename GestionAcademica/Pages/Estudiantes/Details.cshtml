<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        initializeAnimations();
        setupInteractions();
    });

    function initializeAnimations() {
        // Animar elementos al cargar
        const animatedElements = document.querySelectorAll('.info-item, .academic-item, .action-quick');
        animatedElements.forEach((element, index) => {
            element.style.opacity = '0';
            element.style.transform = 'translateY(20px)';
            setTimeout(() => {
                element.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
            }, index * 100 + 1000);
        });
    }

    function setupInteractions() {
        // Efectos hover mejorados
        const actionQuicks = document.querySelectorAll('.action-quick');
        actionQuicks.forEach(action => {
            action.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-3px) scale(1.02)';
            });

            action.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });

        // Efectos para info items
        const infoItems = document.querySelectorAll('.info-item');
        infoItems.forEach(item => {
            item.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px) scale(1.02)';
            });

            item.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });
    }

    function contactStudent() {
        const modal = new bootstrap.Modal(document.getElementById('contactModal'));
        modal.show();
    }

    function printDetails() {
        // Ocultar elementos no necesarios para impresión
        const elementsToHide = document.querySelectorAll('.details-hero-enhanced, .quick-actions-enhanced, .navigation-enhanced');
        elementsToHide.forEach(el => el.style.display = 'none');

        // Imprimir
        window.print();

        // Restaurar elementos
        setTimeout(() => {
            elementsToHide.forEach(el => el.style.display = '');
        }, 100);
    }

    function toggleStatus() {
        // Aquí iría la lógica para cambiar el estado del estudiante
        // Por ahora solo mostramos una alerta
        const isActive = @Model.Estudiante.Activo.ToString().ToLower();
        const action = isActive ? 'desactivar' : 'activar';
        const message = `¿Estás seguro de que deseas ${action} a este estudiante?`;

        if (confirm(message)) {
            // Aquí enviarías la petición al servidor
            alert(`Funcionalidad para ${action} estudiante - implementar en el backend`);
        }
    }

    function confirmDelete() {
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    // Animación del avatar
    function animateAvatar() {
        const avatar = document.querySelector('.avatar-main');
        if (avatar) {
            avatar.style.transform = 'translate(-50%, -50%) scale(1.1)';
            setTimeout(() => {
                avatar.style.transform = 'translate(-50%, -50%) scale(1)';
            }, 200);
        }
    }

    // Ejecutar animación del avatar cada 5 segundos
    setInterval(animateAvatar, 5000);

    // Efecto de escritura para el título
    function typeWriter() {
        const title = document.querySelector('.hero-title-enhanced');
        if (title) {
            const text = title.textContent;
            title.textContent = '';
            title.style.opacity = '1';

            for (let i = 0; i < text.length; i++) {
                setTimeout(() => {
                    title.textContent += text.charAt(i);
                }, i * 50);
            }
        }
    }

    // Ejecutar efecto de escritura después de 1 segundo
    setTimeout(typeWriter, 1000);
</script>