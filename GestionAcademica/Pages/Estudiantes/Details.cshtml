@page
@model GestionAcademica.Pages.Estudiantes.DetailsModel
@{
    ViewData["Title"] = $"Detalles - {Model.Estudiante.Nombres} {Model.Estudiante.Apellidos}";
}

<!-- Hero Header -->
<div class="details-hero-enhanced">
    <div class="hero-bg-pattern"></div>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-content-enhanced">
                    <div class="hero-breadcrumb">
                        <a asp-page="./Index" class="breadcrumb-link">
                            <i class="fas fa-users me-2"></i>
                            Estudiantes
                        </a>
                        <i class="fas fa-chevron-right mx-3"></i>
                        <span class="breadcrumb-current">Detalles del Estudiante</span>
                    </div>
                    <h1 class="hero-title-enhanced">
                        <i class="fas fa-user-graduate me-3"></i>
                        @Model.Estudiante.Nombres @Model.Estudiante.Apellidos
                    </h1>
                    <p class="hero-subtitle-enhanced">
                        Información completa del estudiante registrado en el sistema académico.
                        <span class="student-id">ID: <strong>@Model.Estudiante.EstudianteID</strong></span>
                    </p>
                    <div class="hero-status">
                        @if (Model.Estudiante.Activo)
                        {
                            <div class="status-badge-hero active">
                                <i class="fas fa-check-circle"></i>
                                <span>Estudiante Activo</span>
                            </div>
                        }
                        else
                        {
                            <div class="status-badge-hero inactive">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span>Estudiante Inactivo</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="student-avatar-hero">
                    <div class="avatar-container">
                        <div class="avatar-main">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <div class="avatar-ring"></div>
                        <div class="avatar-pulse"></div>
                    </div>
                    <div class="avatar-info">
                        <h4>@Model.Estudiante.Carnet</h4>
                        <p>Carnet Estudiantil</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Información Principal -->
<div class="container mt-5">
    <div class="row">
        <!-- Información Personal -->
        <div class="col-lg-8">
            <div class="info-card-enhanced">
                <div class="card-header-enhanced">
                    <div class="header-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="header-content">
                        <h3>Información Personal</h3>
                        <p>Datos personales y de contacto del estudiante</p>
                    </div>
                </div>

                <div class="card-body-enhanced">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-id-card"></i>
                            </div>
                            <div class="info-content">
                                <label>Carnet Estudiantil</label>
                                <value>@Model.Estudiante.Carnet</value>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="info-content">
                                <label>Nombres Completos</label>
                                <value>@Model.Estudiante.Nombres</value>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="info-content">
                                <label>Apellidos Completos</label>
                                <value>@Model.Estudiante.Apellidos</value>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="info-content">
                                <label>Correo Electrónico</label>
                                <value class="email-value">
                                    <a href="mailto:@Model.Estudiante.Email">@Model.Estudiante.Email</a>
                                </value>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div class="info-content">
                                <label>Número de Teléfono</label>
                                <value class="phone-value">
                                    <a href="tel:@Model.Estudiante.Telefono">@Model.Estudiante.Telefono</a>
                                </value>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="info-content">
                                <label>Fecha de Nacimiento</label>
                                <value>
                                    @Model.Estudiante.FechaNacimiento?.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
                                    @if (Model.Estudiante.FechaNacimiento.HasValue)
                                    {
                                        var edad = DateTime.Now.Year - Model.Estudiante.FechaNacimiento.Value.Year;
                                        if (DateTime.Now.DayOfYear < Model.Estudiante.FechaNacimiento.Value.DayOfYear) edad--;
                                        <span class="age-badge">@edad años</span>
                                    }
                                </value>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información Académica -->
        <div class="col-lg-4">
            <div class="academic-card-enhanced">
                <div class="academic-header">
                    <div class="academic-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h3>Información Académica</h3>
                </div>

                <div class="academic-body">
                    <div class="academic-item">
                        <div class="academic-label">
                            <i class="fas fa-calendar-plus me-2"></i>
                            Fecha de Ingreso
                        </div>
                        <div class="academic-value">
                            @Model.Estudiante.FechaIngreso.ToString("dd/MM/yyyy")
                        </div>
                        <div class="academic-detail">
                            @{
                                var diasEnSistema = (DateTime.Now - Model.Estudiante.FechaIngreso).Days;
                                var añosEnSistema = Math.Round(diasEnSistema / 365.0, 1);
                            }
                            <small>Hace @diasEnSistema días (@añosEnSistema años)</small>
                        </div>
                    </div>

                    <div class="academic-item">
                        <div class="academic-label">
                            <i class="fas fa-toggle-on me-2"></i>
                            Estado Actual
                        </div>
                        <div class="academic-value">
                            @if (Model.Estudiante.Activo)
                            {
                                <span class="status-active">
                                    <i class="fas fa-check-circle me-2"></i>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="status-inactive">
                                    <i class="fas fa-times-circle me-2"></i>
                                    Inactivo
                                </span>
                            }
                        </div>
                        <div class="academic-detail">
                            @if (Model.Estudiante.Activo)
                            {
                                <small>Puede acceder al sistema y inscribirse en materias</small>
                            }
                            else
                            {
                                <small>No puede acceder al sistema ni inscribirse</small>
                            }
                        </div>
                    </div>

                    <div class="academic-item">
                        <div class="academic-label">
                            <i class="fas fa-hashtag me-2"></i>
                            ID del Sistema
                        </div>
                        <div class="academic-value">
                            <code>#@Model.Estudiante.EstudianteID</code>
                        </div>
                        <div class="academic-detail">
                            <small>Identificador único en la base de datos</small>
                        </div>
                    </div>
                    <!-- Agregar después del último academic-item (ID del Sistema) -->
                    <div class="academic-item">
                        <div class="academic-label">
                            <i class="fas fa-building me-2"></i>
                            Facultad
                        </div>
                        <div class="academic-value">
                            @if (Model.Estudiante.Carrera?.Facultad != null)
                            {
                                <span class="faculty-name">@Model.Estudiante.Carrera.Facultad.Nombre</span>
                            }
                            else
                            {
                                <span class="text-muted">No asignada</span>
                            }
                        </div>
                        <div class="academic-detail">
                            @if (Model.Estudiante.Carrera?.Facultad != null)
                            {
                                <small>Facultad a la que pertenece la carrera del estudiante</small>
                            }
                            else
                            {
                                <small>El estudiante no tiene carrera asignada</small>
                            }
                        </div>
                    </div>

                    <div class="academic-item">
                        <div class="academic-label">
                            <i class="fas fa-graduation-cap me-2"></i>
                            Carrera
                        </div>
                        <div class="academic-value">
                            @if (Model.Estudiante.Carrera != null)
                            {
                                <span class="career-name">@Model.Estudiante.Carrera.Nombre</span>
                                <div class="career-badges">
                                    <span class="badge-code">@Model.Estudiante.Carrera.Codigo</span>
                                    <span class="badge-duration">@Model.Estudiante.Carrera.DuracionAnios años</span>
                                    @if (Model.Estudiante.Carrera.Activa)
                                    {
                                        <span class="badge-status active">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status inactive">Inactiva</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No asignada</span>
                            }
                        </div>
                        <div class="academic-detail">
                            @if (Model.Estudiante.Carrera?.Descripcion != null && !string.IsNullOrWhiteSpace(Model.Estudiante.Carrera.Descripcion))
                            {
                                <small>@Model.Estudiante.Carrera.Descripcion</small>
                            }
                            else if (Model.Estudiante.Carrera != null)
                            {
                                <small>Carrera del estudiante en el sistema académico</small>
                            }
                            else
                            {
                                <small>Es necesario asignar una carrera al estudiante</small>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acciones Rápidas -->
            <div class="quick-actions-enhanced">
                <div class="actions-header">
                    <h4>
                        <i class="fas fa-bolt me-2"></i>
                        Acciones Rápidas
                    </h4>
                </div>
                <div class="actions-grid">
                    <a asp-page="./Edit" asp-route-id="@Model.Estudiante.EstudianteID" class="action-quick edit">
                        <div class="action-icon">
                            <i class="fas fa-edit"></i>
                        </div>
                        <div class="action-content">
                            <span class="action-title">Editar</span>
                            <span class="action-desc">Modificar información</span>
                        </div>
                    </a>

                    <button class="action-quick contact" onclick="contactStudent()">
                        <div class="action-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="action-content">
                            <span class="action-title">Contactar</span>
                            <span class="action-desc">Enviar correo</span>
                        </div>
                    </button>

                    <button class="action-quick print" onclick="printDetails()">
                        <div class="action-icon">
                            <i class="fas fa-print"></i>
                        </div>
                        <div class="action-content">
                            <span class="action-title">Imprimir</span>
                            <span class="action-desc">Generar reporte</span>
                        </div>
                    </button>

                    <button class="action-quick toggle" onclick="toggleStatus()">
                        <div class="action-icon">
                            @if (Model.Estudiante.Activo)
                            {
                                <i class="fas fa-user-slash"></i>
                            }
                            else
                            {
                                <i class="fas fa-user-check"></i>
                            }
                        </div>
                        <div class="action-content">
                            @if (Model.Estudiante.Activo)
                            {
                                <span class="action-title">Desactivar</span>
                                <span class="action-desc">Suspender estudiante</span>
                            }
                            else
                            {
                                <span class="action-title">Activar</span>
                                <span class="action-desc">Habilitar estudiante</span>
                            }
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Navegación -->
<div class="container mt-4">
    <div class="navigation-enhanced">
        <div class="nav-content">
            <a asp-page="./Index" class="nav-btn secondary">
                <i class="fas fa-arrow-left me-2"></i>
                <span>Volver a la Lista</span>
            </a>

            <div class="nav-actions">
                <a asp-page="./Edit" asp-route-id="@Model.Estudiante.EstudianteID" class="nav-btn primary">
                    <i class="fas fa-edit me-2"></i>
                    <span>Editar Estudiante</span>
                </a>

                <button class="nav-btn danger" onclick="confirmDelete()">
                    <i class="fas fa-trash me-2"></i>
                    <span>Eliminar</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content delete-modal-enhanced">
            <div class="modal-body text-center">
                <div class="delete-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h3>¿Eliminar Estudiante?</h3>
                <p>¿Estás seguro de que deseas eliminar a <strong>@Model.Estudiante.Nombres @Model.Estudiante.Apellidos</strong>?</p>
                <p class="warning-text">Esta acción eliminará permanentemente todos los datos del estudiante y no se puede deshacer.</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>
                        Cancelar
                    </button>
                    <form method="post" style="display: inline;">
                        <input type="hidden" name="id" value="@Model.Estudiante.EstudianteID">
                        <button type="submit" class="btn btn-danger" formaction="/Estudiantes/Delete">
                            <i class="fas fa-trash me-2"></i>
                            Eliminar Definitivamente
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Contacto -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content contact-modal-enhanced">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-envelope me-2"></i>
                    Contactar Estudiante
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="contact-options">
                    <a href="mailto:@Model.Estudiante.Email" class="contact-option">
                        <div class="contact-icon email">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-info">
                            <h6>Enviar Email</h6>
                            <p>@Model.Estudiante.Email</p>
                        </div>
                    </a>

                    <a href="tel:@Model.Estudiante.Telefono" class="contact-option">
                        <div class="contact-icon phone">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-info">
                            <h6>Llamar</h6>
                            <p>@Model.Estudiante.Telefono</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Variables CSS */
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --secondary-gradient: linear-gradient(45deg, #f093fb 0%, #f5576c 100%);
        --success-gradient: linear-gradient(45deg, #4facfe 0%, #00f2fe 100%);
        --warning-gradient: linear-gradient(45deg, #ffd89b 0%, #19547b 100%);
        --danger-gradient: linear-gradient(45deg, #ff6b6b 0%, #ffa726 100%);
        --shadow-soft: 0 10px 40px rgba(0,0,0,0.1);
        --shadow-hover: 0 20px 60px rgba(0,0,0,0.15);
        --border-radius: 20px;
        --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Hero Section */
    .details-hero-enhanced {
        background: var(--primary-gradient);
        color: white;
        padding: 4rem 0;
        margin-top: -2rem;
        border-radius: 0 0 40px 40px;
        position: relative;
        overflow: hidden;
    }

    .hero-bg-pattern {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255,255,255,0.1) 0%, transparent 50%), radial-gradient(circle at 40% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
        animation: patternMove 20s linear infinite;
    }

    @@keyframes patternMove {
        0% {
            transform: translateX(0) translateY(0);
        }

        100% {
            transform: translateX(-100px) translateY(-100px);
        }
    }

    .hero-content-enhanced {
        position: relative;
        z-index: 2;
    }

    .hero-breadcrumb {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        animation: fadeInUp 0.6s ease-out;
    }

    .breadcrumb-link {
        color: rgba(255,255,255,0.9);
        text-decoration: none;
        transition: var(--transition);
    }

        .breadcrumb-link:hover {
            color: white;
            text-decoration: underline;
        }

    .breadcrumb-current {
        color: rgba(255,255,255,0.7);
    }

    .hero-title-enhanced {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        animation: fadeInUp 0.6s ease-out 0.2s both;
        text-shadow: 0 4px 20px rgba(0,0,0,0.2);
        line-height: 1.2;
    }

    .hero-subtitle-enhanced {
        font-size: 1.2rem;
        margin-bottom: 2rem;
        opacity: 0.95;
        line-height: 1.7;
        animation: fadeInUp 0.6s ease-out 0.4s both;
    }

    .student-id {
        display: block;
        margin-top: 0.5rem;
        font-size: 1rem;
        opacity: 0.8;
    }

    .hero-status {
        animation: fadeInUp 0.6s ease-out 0.6s both;
    }

    .status-badge-hero {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 2rem;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 700;
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255,255,255,0.3);
    }

        .status-badge-hero.active {
            background: rgba(39, 174, 96, 0.2);
            color: #4facfe;
        }

        .status-badge-hero.inactive {
            background: rgba(231, 76, 60, 0.2);
            color: #ff6b6b;
        }

    /* Avatar Hero */
    .student-avatar-hero {
        position: relative;
        z-index: 2;
        animation: fadeInUp 0.6s ease-out 0.8s both;
    }

    .avatar-container {
        position: relative;
        width: 200px;
        height: 200px;
        margin: 0 auto 2rem auto;
    }

    .avatar-main {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(15px);
        border: 3px solid rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: white;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 3;
        animation: float 3s ease-in-out infinite;
    }

    .avatar-ring {
        width: 180px;
        height: 180px;
        border: 2px solid rgba(255,255,255,0.2);
        border-radius: 50%;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation: rotate 10s linear infinite;
    }

    .avatar-pulse {
        width: 200px;
        height: 200px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 50%;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation: pulse 2s ease-in-out infinite;
    }

    .avatar-info {
        text-align: center;
    }

        .avatar-info h4 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .avatar-info p {
            opacity: 0.8;
            font-size: 1rem;
        }

    @@keyframes float {
        0%, 100% {
            transform: translate(-50%, -50%) translateY(0px);
        }

        50% {
            transform: translate(-50%, -50%) translateY(-10px);
        }
    }

    @@keyframes rotate {
        0% {
            transform: translate(-50%, -50%) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.1;
        }

        50% {
            transform: translate(-50%, -50%) scale(1.1);
            opacity: 0.3;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Información Card */
    .info-card-enhanced {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
        margin-bottom: 2rem;
        animation: slideInLeft 0.6s ease-out;
    }

    .card-header-enhanced {
        background: linear-gradient(145deg, #f8f9fa, #e9ecef);
        padding: 2rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
    }

    .header-content h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .header-content p {
        margin: 0;
        color: #6c757d;
        font-size: 1rem;
    }

    .card-body-enhanced {
        padding: 2.5rem;
    }

    .info-grid {
        display: grid;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        padding: 1.5rem;
        background: linear-gradient(145deg, #f8f9fa, #ffffff);
        border-radius: 15px;
        border: 2px solid transparent;
        transition: var(--transition);
        position: relative;
