@page
@model GestionAcademica.Pages.Configuracion.IndexModel

@{
    ViewData["Title"] = "Configuración";
}

<!-- Hero Header -->
<div class="config-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="fas fa-cog me-2"></i>
                        Configuración
                    </div>
                    <h1 class="hero-title">
                        <i class="fas fa-user-cog me-3"></i>
                        Configuración del Perfil
                    </h1>
                    <p class="hero-subtitle">
                        Gestiona la configuración de tu cuenta y actualiza tu información personal.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 text-end">
                <a asp-page="/Home/Index" class="btn btn-back">
                    <i class="fas fa-arrow-left me-2"></i>
                    Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Mensajes -->
@if (TempData["SuccessMessage"] != null)
{
        <div class="container mt-4">
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
}

@if (TempData["ErrorMessage"] != null)
{
        <div class="container mt-4">
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
}

<div class="container mt-4">
    <div class="row">
        <!-- Información del Perfil -->
        <div class="col-lg-4">
            <div class="profile-card">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3 class="profile-name">@Model.DocenteNombre</h3>
                    <span class="profile-role">@Model.DocenteRol</span>
                </div>

                <div class="profile-info">
                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-envelope me-2"></i>
                            Email
                        </div>
                        <div class="info-value">@Model.DocenteEmail</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-user-tag me-2"></i>
                            Rol
                        </div>
                        <div class="info-value">@Model.DocenteRol</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-calendar-plus me-2"></i>
                            Fecha de Registro
                        </div>
                        <div class="info-value">@Model.FechaRegistro.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-clock me-2"></i>
                            Última Actividad
                        </div>
                        <div class="info-value">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario de Cambio de Contraseña -->
        <div class="col-lg-8">
            <div class="config-card">
                <div class="config-header">
                    <h4>
                        <i class="fas fa-key me-2"></i>
                        Cambiar Contraseña
                    </h4>
                    <p class="text-muted">
                        Por seguridad, actualiza tu contraseña regularmente. Debe tener al menos 6 caracteres.
                    </p>
                </div>

                <form method="post" class="config-form">
                    <div class="row">
                        <div class="col-12">
                            <!-- Contraseña Actual -->
                            <div class="form-group">
                                <label asp-for="CambiarContrasena.ContrasenaActual" class="form-label">
                                    <i class="fas fa-lock me-1"></i>
                                    Contraseña Actual
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-shield-alt"></i>
                                    </span>
                                    <input asp-for="CambiarContrasena.ContrasenaActual" 
                                           type="password" 
                                           class="form-control" 
                                           placeholder="Ingresa tu contraseña actual" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ContrasenaActual')">
                                        <i class="fas fa-eye" id="iconContrasenaActual"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="CambiarContrasena.ContrasenaActual" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <!-- Nueva Contraseña -->
                            <div class="form-group">
                                <label asp-for="CambiarContrasena.NuevaContrasena" class="form-label">
                                    <i class="fas fa-key me-1"></i>
                                    Nueva Contraseña
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-plus-circle"></i>
                                    </span>
                                    <input asp-for="CambiarContrasena.NuevaContrasena" 
                                           type="password" 
                                           class="form-control" 
                                           placeholder="Mínimo 6 caracteres" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('NuevaContrasena')">
                                        <i class="fas fa-eye" id="iconNuevaContrasena"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="CambiarContrasena.NuevaContrasena" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- Confirmar Contraseña -->
                            <div class="form-group">
                                <label asp-for="CambiarContrasena.ConfirmarContrasena" class="form-label">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Confirmar Contraseña
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-check-double"></i>
                                    </span>
                                    <input asp-for="CambiarContrasena.ConfirmarContrasena" 
                                           type="password" 
                                           class="form-control" 
                                           placeholder="Confirma la nueva contraseña" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ConfirmarContrasena')">
                                        <i class="fas fa-eye" id="iconConfirmarContrasena"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="CambiarContrasena.ConfirmarContrasena" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Consejos de Seguridad -->
                    <div class="security-tips">
                        <h6><i class="fas fa-lightbulb me-2"></i>Consejos de Seguridad</h6>
                        <ul>
                            <li>Usa al menos 6 caracteres</li>
                            <li>Combina letras, números y símbolos</li>
                            <li>No uses información personal obvia</li>
                            <li>Cambia tu contraseña regularmente</li>
                        </ul>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="form-actions">
                        <button type="submit" class="btn btn-update">
                            <i class="fas fa-save me-2"></i>
                            Actualizar Contraseña
                        </button>
                        <button type="reset" class="btn btn-reset">
                            <i class="fas fa-undo me-2"></i>
                            Limpiar Formulario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hero Section */
    .config-hero {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        color: white;
        padding: 3rem 0;
        margin-top: -2rem;
        border-radius: 0 0 30px 30px;
    }

    .hero-badge {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        line-height: 1.6;
    }

    .btn-back {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255,255,255,0.3);
        color: white;
        padding: 1rem 2rem;
        border-radius: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.3);
        transform: translateY(-2px);
        color: white;
    }

    /* Profile Card */
    .profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .profile-header {
        background: linear-gradient(45deg, #6c757d, #495057);
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .profile-avatar {
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 2rem;
    }

    .profile-name {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .profile-role {
        background: rgba(255,255,255,0.2);
        padding: 0.3rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .profile-info {
        padding: 2rem;
    }

    .info-item {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #f1f3f4;
    }

    .info-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }

    .info-label {
        font-weight: 600;
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 0.3rem;
    }

    .info-value {
        color: #2c3e50;
        font-weight: 500;
    }

    /* Config Card */
    .config-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        padding: 2rem;
    }

    .config-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f1f3f4;
    }

    .config-header h4 {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .config-form {
        margin-top: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.8rem 1rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #6c757d;
        box-shadow: 0 0 0 0.2rem rgba(108, 117, 125, 0.25);
    }

    .input-group-text {
        background: #6c757d;
        color: white;
        border: 2px solid #6c757d;
        font-weight: 600;
    }

    /* Security Tips */
    .security-tips {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 1.5rem;
        margin: 2rem 0;
        border-left: 4px solid #6c757d;
    }

    .security-tips h6 {
        color: #2c3e50;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .security-tips ul {
        margin-bottom: 0;
        padding-left: 1.5rem;
    }

    .security-tips li {
        color: #6c757d;
        margin-bottom: 0.3rem;
    }

    /* Action Buttons */
    .form-actions {
        text-align: center;
        padding-top: 2rem;
        border-top: 2px solid #f1f3f4;
        margin-top: 2rem;
    }

    .btn-update {
        background: linear-gradient(45deg, #6c757d, #495057);
        color: white;
        border: none;
        padding: 1rem 3rem;
        border-radius: 15px;
        font-weight: 600;
        font-size: 1.1rem;
        margin-right: 1rem;
        transition: all 0.3s ease;
    }

    .btn-update:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(108, 117, 125, 0.3);
        color: white;
    }

    .btn-reset {
        background: #dc3545;
        color: white;
        border: none;
        padding: 1rem 3rem;
        border-radius: 15px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-reset:hover {
        background: #c82333;
        transform: translateY(-2px);
        color: white;
    }

</style>

<script>
    function togglePassword(fieldName) {
        const field = document.querySelector(`input[name="CambiarContrasena.${fieldName}"]`);
        const icon = document.querySelector(`#icon${fieldName}`);

        if (field.type === 'password') {
            field.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            field.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}</script>