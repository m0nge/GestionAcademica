<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Variables globales
    let barChart, pieChart, lineChart;
    let datosGraficos = @Html.Raw(Model.DatosGraficosJson);

    // Función principal para actualizar gráficos
    function actualizarGraficos() {
        const selector = document.getElementById('materiaSelector');
        const container = document.getElementById('graficosContainer');
        const materiaId = parseInt(selector.value);

        if (!materiaId) {
            container.style.display = 'none';
            return;
        }

        container.style.display = 'block';

        // Encontrar datos de la materia seleccionada
        const datos = datosGraficos.find(d => d.materiaID === materiaId);
        if (!datos) {
            console.log('No se encontraron datos para la materia:', materiaId);
            return;
        }

        // Actualizar badges con información real
        document.getElementById('badge1').textContent = datos.materiaCodigo;
        document.getElementById('badge2').textContent = `${datos.estudiantesPromedios.length} estudiantes`;
        document.getElementById('badge3').textContent = 'Progreso Actual';

        // Destruir gráficos existentes
        if (barChart) { barChart.destroy(); barChart = null; }
        if (pieChart) { pieChart.destroy(); pieChart = null; }
        if (lineChart) { lineChart.destroy(); lineChart = null; }

        // Crear nuevos gráficos con datos ordenados
        crearGraficoBarras(datos.estudiantesPromedios);
        crearGraficoPastel(datos.distribucion);
        crearGraficoLineas(datos.progreso);

        // Scroll suave a los gráficos
        setTimeout(() => {
            container.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }, 100);
    }

    function crearGraficoBarras(estudiantes) {
        const ctx = document.getElementById('barChart').getContext('2d');

        if (!estudiantes || estudiantes.length === 0) {
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
            ctx.fillStyle = '#666';
            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('No hay datos disponibles', ctx.canvas.width/2, ctx.canvas.height/2);
            return;
        }

        const labels = estudiantes.map(e => e.estudianteNombre);
        const data = estudiantes.map(e => parseFloat(e.promedio));

        // Colores según el promedio
        const backgroundColors = data.map(promedio => {
            if (promedio >= 8) return '#28a745';
            if (promedio >= 6) return '#ffc107';
            if (promedio >= 4) return '#fd7e14';
            return '#dc3545';
        });

        barChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Promedio',
                    data: data,
                    backgroundColor: backgroundColors,
                    borderColor: backgroundColors,
                    borderWidth: 1,
                    borderRadius: 8,
                    borderSkipped: false,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        titleColor: 'white',
                        bodyColor: 'white',
                        cornerRadius: 8,
                        callbacks: {
                            title: function(tooltipItems) {
                                return tooltipItems[0].label;
                            },
                            label: function(context) {
                                return `Promedio: ${context.parsed.y.toFixed(1)}/10`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 10,
                        grid: {
                            color: 'rgba(0,0,0,0.1)',
                            lineWidth: 1
                        },
                        ticks: {
                            stepSize: 2,
                            callback: function(value) {
                                return value.toFixed(0);
                            }
                        }
                    },
                    x: {
                        grid: { display: false },
                        ticks: {
                            maxRotation: 45,
                            minRotation: 0,
                            font: { size: 11 }
                        }
                    }
                }
            }
        });
    }

    function crearGraficoPastel(distribucion) {
        const ctx = document.getElementById('pieChart').getContext('2d');

        if (!distribucion) {
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
            ctx.fillStyle = '#666';
            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('No hay datos disponibles', ctx.canvas.width/2, ctx.canvas.height/2);
            return;
        }

        const data = [
            distribucion.aprobados || 0,
            distribucion.enCurso || 0,
            distribucion.reprobados || 0
        ];

        const labels = ['Aprobados (≥6)', 'En Curso (1-5.9)', 'Reprobados (<1)'];
        const colores = ['#28a745', '#ffc107', '#dc3545'];

        // Solo mostrar categorías con datos
        const datosValidos = [];
        const labelsValidos = [];
        const coloresValidos = [];

        data.forEach((valor, index) => {
            if (valor > 0) {
                datosValidos.push(valor);
                labelsValidos.push(labels[index]);
                coloresValidos.push(colores[index]);
            }
        });

        if (datosValidos.length === 0) {
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
            ctx.fillStyle = '#666';
            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('No hay estudiantes calificados', ctx.canvas.width/2, ctx.canvas.height/2);
            return;
        }

        pieChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labelsValidos,
                datasets: [{
                    data: datosValidos,
                    backgroundColor: coloresValidos,
                    borderWidth: 4,
                    borderColor: '#fff',
                    hoverBorderWidth: 6,
                    hoverBackgroundColor: coloresValidos.map(color => color + 'DD')
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            font: { size: 12 },
                            generateLabels: function(chart) {
                                const data = chart.data;
                                return data.labels.map((label, i) => ({
                                    text: `${label}: ${data.datasets[0].data[i]}`,
                                    fillStyle: data.datasets[0].backgroundColor[i],
                                    pointStyle: 'circle'
                                }));
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        titleColor: 'white',
                        bodyColor: 'white',
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return `${context.label}: ${context.parsed} estudiantes (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    function crearGraficoLineas(progreso) {
        const ctx = document.getElementById('lineChart').getContext('2d');

        if (!progreso || progreso.length === 0) {
            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
            ctx.fillStyle = '#666';
            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('No hay datos de progreso', ctx.canvas.width/2, ctx.canvas.height/2);
            return;
        }

        const labels = progreso.map(p => p.semana);
        const data = progreso.map(p => parseFloat(p.porcentaje));

        lineChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Progreso del Curso',
                    data: data,
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderWidth: 4,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#667eea',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 3,
                    pointRadius: 6,
                    pointHoverRadius: 8,
                    pointHoverBackgroundColor: '#5a67d8'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        titleColor: 'white',
                        bodyColor: 'white',
                        cornerRadius: 8,
                        callbacks: {
                            title: function(tooltipItems) {
                                return tooltipItems[0].label;
                            },
                            label: function(context) {
                                return `Progreso: ${context.parsed.y}%`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: {
                            color: 'rgba(0,0,0,0.1)',
                            lineWidth: 1
                        },
                        ticks: {
                            stepSize: 25,
                            callback: function(value) {
                                return value + '%';
                            }
                        }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 11 } }
                    }
                }
            }
        });
    }

    // Funciones para las acciones
    function actualizarBotonesEstudiante(selectElement) {
        const card = selectElement.closest('.materia-card');
        const btnVerBoleta = card.querySelector('.btn-ver-boleta');
        const btnDescargarPDF = card.querySelector('.btn-descargar-pdf');

        if (selectElement.value) {
            btnVerBoleta.disabled = false;
            btnDescargarPDF.disabled = false;
        } else {
            btnVerBoleta.disabled = true;
            btnDescargarPDF.disabled = true;
        }
    }

    function verBoletaMateria(button) {
        const card = button.closest('.materia-card');
        const select = card.querySelector('.estudiante-select');
        const estudianteId = select.value;

        if (estudianteId) {
            window.open(`/Reportes/BoletaNotas?estudianteId=${estudianteId}`, '_blank');
        }
    }

    function descargarBoletaMateria(button) {
        const card = button.closest('.materia-card');
        const select = card.querySelector('.estudiante-select');
        const estudianteId = select.value;

        if (estudianteId) {
            window.open(`/Reportes/BoletaNotas?estudianteId=${estudianteId}&formato=pdf`, '_blank');
        }
    }

    function mostrarGraficosMateria(materiaId) {
        const selector = document.getElementById('materiaSelector');
        selector.value = materiaId;
        actualizarGraficos();
    }

    // Inicialización
    document.addEventListener('DOMContentLoaded', function() {
        console.log('📊 Reportes cargados correctamente');
        console.log('Datos de gráficos:', datosGraficos);

        if (typeof Chart === 'undefined') {
            console.error('Chart.js no está disponible');
        } else {
            console.log('Chart.js versión:', Chart.version);
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

