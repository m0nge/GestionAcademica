<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Función para imprimir la boleta
    function imprimirBoleta() {
        window.print();
    }

    // Auto-abrir ventana de impresión si es PDF
    @if (Model.EsPDF)
    {
            <text>
                window.addEventListener('load', function() {
                    setTimeout(function() {
                        window.print();
                    }, 1000);
                });
            </text>
    }

    // Función para generar PDF
    function generarPDF() {
        const estudianteId = @Model.EstudianteId;
        window.open(`/Reportes/BoletaNotas?estudianteId=${estudianteId}&formato=pdf`, '_blank');
    }

    // Mejorar la experiencia de impresión
    window.addEventListener('beforeprint', function() {
        // Ocultar elementos que no deben imprimirse
        const elements = document.querySelectorAll('.btn-back, .btn-print, .boleta-hero');
        elements.forEach(el => {
            el.style.display = 'none';
        });
    });

    window.addEventListener('afterprint', function() {
        // Restaurar elementos después de imprimir
        const elements = document.querySelectorAll('.btn-back, .btn-print, .boleta-hero');
        elements.forEach(el => {
            el.style.display = '';
        });
    });
</script>